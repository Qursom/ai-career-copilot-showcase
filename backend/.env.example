NODE_ENV=
# Local default 3001. On Render, omit PORT — the platform sets it.
PORT=
API_PREFIX=

# Credentialed CORS allowlist (comma-separated). Production must be the real UI origin, not *.
CORS_ORIGIN=

THROTTLE_TTL_MS=
THROTTLE_LIMIT=

LOG_LEVEL=

# --- LLM (chat / JSON) ---

LLM_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
LLM_TIMEOUT_MS=

# --- Mongo / cache ---
MONGODB_URI=
# Optional local Redis (Docker). Ignored for sessions/cache when Upstash REST is set.
REDIS_URL=
# Upstash console → REST API → copy these two (used on Render for sessions/cache).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_CACHE_TTL_SECONDS=
SESSION_TTL_SECONDS=

# --- Auth ---
# Accepts an `x-user-id` header as the caller's identity so the API is usable
# without Firebase keys. Keep this false unless you are running locally: it is
# arbitrary account impersonation. The guard also refuses it when NODE_ENV is
# production or when Firebase Admin is configured.
AUTH_DEV_BYPASS=

# --- Firebase Admin (never expose these to the frontend) ---
# Prefer the downloaded service-account JSON (path is relative to /backend).
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

RESUME_COIN_COST=
JOB_MATCH_COIN_COST=
USER_STARTING_COINS=
RESUME_MAX_FILE_SIZE_MB=
RESUME_ANALYSIS_MAX_RETRIES=

# Cookie Domain when API and UI share a parent domain (e.g. .example.com).
SESSION_COOKIE_DOMAIN=
# Public site origin (UI).
FRONTEND_URL=
# Production-only: allow LLM_PROVIDER=mock on a staging deploy.
ALLOW_MOCK_LLM=
LOG_FORMAT=
SENTRY_DSN=

