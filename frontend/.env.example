NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Firebase web app config (Project settings → General → Your apps → Web).
# Every NEXT_PUBLIC_* value ships to the browser — never put backend secrets
# (MONGODB_URI, REDIS_URL, FIREBASE_PRIVATE_KEY) behind this prefix.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional — only needed if you use Firebase Storage / Cloud Messaging.
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Stripe keys stay on the API (backend/.env). Do not put sk_ / whsec_ here.
